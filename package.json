{
  "name": "unrealfest-avatar",
  "version": "1.0.0",
  "description": "Facing Worlds: a browser multiplayer FPS on three.js r180 and WebSockets, recreating UT99's CTF-Face",
  "main": "index.html",
  "scripts": {
    "start": "npx http-server . -p 8080 -c-1",
    "dev": "npx http-server . -p 8080 -c-1 --cors",
    "build": "echo 'No build step required for this project'",
    "server": "node server/server.js",
    "server:tls": "SSL_CERT=$HOME/.local-certs/facingworlds/cert.pem SSL_KEY=$HOME/.local-certs/facingworlds/key.pem node server/server.js",
    "test": "node src/shared/net/interpolation.test.mjs && npm run test:server",
    "test:ctf": "node --test server/test/ctf.test.mjs",
    "test:bots": "node --test server/test/bots.test.mjs server/test/bots-gate.test.mjs server/test/bots-los.test.mjs",
    "test:surface": "node --test server/test/navmesh-surface.test.mjs",
    "test:server": "node --test server/test/*.test.mjs",
    "gen:map-actors": "node scripts/gen-map-actors.mjs",
    "gen:map-actors:check": "node scripts/gen-map-actors.mjs --check",
    "gen:nav-graph": "node scripts/gen-nav-graph.mjs",
    "gen:nav-graph:check": "node scripts/gen-nav-graph.mjs --check",
    "gen:navmesh-surface": "node scripts/gen-navmesh-surface.mjs",
    "gen:navmesh-surface:check": "node scripts/gen-navmesh-surface.mjs --check",
    "gen:map-collision": "node scripts/gen-map-collision.mjs",
    "gen:map-collision:check": "node scripts/gen-map-collision.mjs --check",
    "gen:characters": "node scripts/gen-characters.mjs",
    "gen:characters:check": "node scripts/gen-characters.mjs --check",
    "gen:weapons": "node scripts/gen-weapons.mjs",
    "gen:weapons:check": "node scripts/gen-weapons.mjs --check",
    "gen:announcer": "node scripts/gen-announcer.mjs",
    "gen:announcer:check": "node scripts/gen-announcer.mjs --check",
    "gen:effects": "node scripts/gen-effects.mjs",
    "gen:effects:check": "node scripts/gen-effects.mjs --check",
    "optimize:assets": "node scripts/optimize-assets.mjs",
    "optimize:assets:webp": "node scripts/optimize-assets.mjs --codec=webp",
    "optimize:assets:ktx2": "node scripts/optimize-assets.mjs --codec=ktx2",
    "optimize:assets:dry": "node scripts/optimize-assets.mjs --dry-run",
    "inspect:assets": "gltf-transform inspect"
  },
  "keywords": [
    "three.js",
    "webgl",
    "websocket",
    "multiplayer",
    "3d",
    "game"
  ],
  "author": "UnrealFest Team",
  "license": "MIT",
  "devDependencies": {
    "@gltf-transform/cli": "^4.4.2",
    "http-server": "^14.1.1",
    "playwright": "^1.63.0",
    "three": "^0.180.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/unrealfest-avatar.git"
  },
  "bugs": {
    "url": "https://github.com/your-username/unrealfest-avatar/issues"
  },
  "homepage": "https://github.com/your-username/unrealfest-avatar#readme"
}
